-- =================================================================
--  ROUTEL — HYPRLAND 0.55+ (Lua config)
--  Migrado desde hyprland.conf (hyprlang → Lua)
-- =================================================================

local mainMod = "SUPER"

-- =================================================================
-- ENV: Portal / Session
-- =================================================================
hl.env("XDG_CURRENT_DESKTOP",  "Hyprland")
hl.env("XDG_SESSION_DESKTOP",  "Hyprland")
hl.env("XDG_SESSION_TYPE",     "wayland")

-- NVIDIA
hl.env("LIBVA_DRIVER_NAME",             "nvidia")
hl.env("GBM_BACKEND",                   "nvidia-drm")
hl.env("__GLX_VENDOR_LIBRARY_NAME",     "nvidia")
hl.env("NVD_BACKEND",                   "direct")

-- Electron / Java
hl.env("ELECTRON_OZONE_PLATFORM_HINT",  "auto")
hl.env("_JAVA_AWT_WM_NONREPARENTING",   "1")
hl.env("AWT_TOOLKIT",                   "MToolkit")

-- =================================================================
-- AUTOSTART
-- =================================================================
hl.exec_once("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE")
hl.exec_once("systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE")
hl.exec_once("nm-applet --indicator")
hl.exec_once("~/.config/hypr/scripts/MediaCtrl.sh daemon")
hl.exec_once("hypridle")
hl.exec_once("playerctld daemon")
hl.exec_once("wl-paste --type text --watch cliphist store")
hl.exec_once([[wl-paste --type image --watch sh -c 'head -c 5242880 | cliphist store']])
hl.exec_once("waybar")
hl.exec_once("/home/routel/.local/bin/set-wp.sh 1754774530")

-- =================================================================
-- HARDWARE: MONITOR
-- =================================================================
hl.monitor({
    output   = "DP-1",
    mode     = "1920x1080@75",
    position = "0x0",
    scale    = 1,
})

-- =================================================================
-- CONFIG PRINCIPAL
-- =================================================================
hl.config({
    cursor = {
        no_hardware_cursors = true,
    },

    input = {
        kb_layout    = "us,es",
        kb_options   = "grp:alt_shift_toggle",
        follow_mouse = 1,
        sensitivity  = 0,
        touchpad = {
            natural_scroll = false,
        },
    },

    xwayland = {
        enabled            = true,
        force_zero_scaling = true,
    },

    misc = {
        -- NOTA: vfr fue eliminado de misc en 0.55 (se movió a debug, no recomendado)
        -- pseudotile también fue eliminado del config global en 0.55
        disable_hyprland_logo    = true,
        disable_splash_rendering = true,
        mouse_move_enables_dpms  = true,
        key_press_enables_dpms   = true,
        enable_swallow           = true,
        swallow_regex            = "^(kitty)$",
    },

    general = {
        gaps_in       = 8,
        gaps_out      = 0,
        border_size   = 1,
        layout        = "dwindle",
        allow_tearing = true,
        col = {
            active_border   = "rgba(ffffff44) rgba(ffffff11)",
            inactive_border = "rgba(ffffff00)",
        },
    },

    decoration = {
        rounding       = 0,
        rounding_power = 4.0,

        shadow = {
            enabled      = true,
            range        = 4,
            render_power = 3,
            color        = "rgba(00000044)",
            offset       = "0 0",
            scale        = 1.0,
        },

        blur = {
            enabled            = true,
            size               = 1,
            passes             = 2,
            vibrancy           = 0.5,
            vibrancy_darkness  = 0.0,
            noise              = 0.02,
            contrast           = 0.5,
            brightness         = 1,
            new_optimizations  = true,
            xray               = false,
            ignore_opacity     = true,
            popups             = true,
            popups_ignorealpha = 0.2,
        },

        dim_inactive = true,
        dim_strength = 0.1,
        dim_special  = 0.8,
        dim_around   = 0.4,
    },

    dwindle = {
        -- pseudotile eliminado en 0.55 como opción global; usa SUPER+P para toggle por ventana
        preserve_split = true,
        smart_split    = false,
        smart_resizing = true,
    },

    master = {
        new_status = "master",
    },
})

-- =================================================================
-- ANIMACIONES SUAVES (Spring + Decel)
-- Curvas tipo iOS: rebote suave sin exagerar
-- =================================================================

-- Curva spring: masa=1, stiffness=60, dampening=14 → suave y fluido
hl.curve("softSpring", {
    type      = "spring",
    mass      = 1,
    stiffness = 60,
    dampening = 14,
})

-- Curva bezier de desaceleración clásica
hl.curve("decel", {
    type   = "bezier",
    points = { {0.05, 0.70}, {0.10, 1.00} },
})

-- Global enable
hl.animation({ leaf = "global",   enabled = true, speed = 4, curve = "decel" })

-- Ventanas: slide con spring suave
hl.animation({ leaf = "windows",    enabled = true, speed = 4, curve = "softSpring", style = "slide" })
hl.animation({ leaf = "windowsIn",  enabled = true, speed = 4, curve = "softSpring", style = "slide" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = 4, curve = "softSpring", style = "slide" })

-- Bordes
hl.animation({ leaf = "border",  enabled = true, speed = 5, curve = "decel" })

-- Fade
hl.animation({ leaf = "fade",    enabled = true, speed = 4, curve = "decel" })

-- Workspaces: slidefade 20% → se siente muy fluido
hl.animation({ leaf = "workspaces",      enabled = true, speed = 6, curve = "decel", style = "slidefade 20%" })
hl.animation({ leaf = "specialWorkspace",enabled = true, speed = 6, curve = "decel", style = "slidefade 20%" })

-- =================================================================
-- WORKSPACES ESPECIALES
-- =================================================================
hl.workspace({ name = "special:music",  gapsout = 0, gapsin = 0 })
hl.workspace({ name = "w[tv1]",         gapsout = 0, gapsin = 0 })
hl.workspace({ name = "f[1]",           gapsout = 0, gapsin = 0 })

-- =================================================================
-- WINDOW RULES
-- =================================================================

-- ── TERMINALES ───────────────────────────────────────────────────
hl.window_rule({ match = { class = "^kitty$" },      opacity = "1 0.8" })
hl.window_rule({ match = { class = "^Alacritty$" },  opacity = "0.88 0.82" })

hl.window_rule({ match = { class = "^floating_kitty$" }, float   = true })
hl.window_rule({ match = { class = "^floating_kitty$" }, opacity = "0.7 0.75" })
hl.window_rule({ match = { class = "^floating_kitty$" }, rounding     = 16 })
hl.window_rule({ match = { class = "^floating_kitty$" }, size         = "(monitor_w*0.9) (monitor_h*0.35)" })
hl.window_rule({ match = { class = "^floating_kitty$" }, move         = "(monitor_w*0.05) 40" })

-- ── NAVEGADORES ──────────────────────────────────────────────────
hl.window_rule({ match = { class = "^(firefox|Firefox)$" },             opaque   = true })
hl.window_rule({ match = { class = "^(firefox|Firefox)$" },             no_blur  = true })
hl.window_rule({ match = { class = "^(brave-browser|Brave-browser)$" }, opaque   = false })
hl.window_rule({ match = { class = "^(brave-browser|Brave-browser)$" }, no_blur  = false })
hl.window_rule({ match = { class = "^(chromium|Google-chrome)$" },      opaque   = true })
hl.window_rule({ match = { class = "^(chromium|Google-chrome)$" },      no_blur  = true })

-- ── APPLE MUSIC PWA ──────────────────────────────────────────────
hl.window_rule({ match = { class = "^brave-music\\.apple\\.com.*" }, float      = true })
hl.window_rule({ match = { class = "^brave-music\\.apple\\.com.*" }, no_shadow  = true })
hl.window_rule({ match = { class = "^brave-music\\.apple\\.com.*" }, opaque     = false })
hl.window_rule({ match = { class = "^brave-music\\.apple\\.com.*" }, no_blur    = false })
hl.window_rule({ match = { class = "^brave-music\\.apple\\.com.*" }, opacity    = "1 override 0.75 override" })
hl.window_rule({ match = { class = "^brave-music\\.apple\\.com.*" }, workspace  = "special:music" })

-- ── YOUTUBE MUSIC PWA ────────────────────────────────────────────
hl.window_rule({ match = { class = "^brave-music\\.youtube\\.com.*" }, float     = true })
hl.window_rule({ match = { class = "^brave-music\\.youtube\\.com.*" }, no_shadow = true })
hl.window_rule({ match = { class = "^brave-music\\.youtube\\.com.*" }, opaque    = false })
hl.window_rule({ match = { class = "^brave-music\\.youtube\\.com.*" }, no_blur   = false })
hl.window_rule({ match = { class = "^brave-music\\.youtube\\.com.*" }, opacity   = "1 override 0.75 override" })
hl.window_rule({ match = { class = "^brave-music\\.youtube\\.com.*" }, workspace = "special:music" })

-- ── QOBUZ PWA ────────────────────────────────────────────────────
hl.window_rule({ match = { class = "^brave-play\\.qobuz\\.com.*" }, float     = true })
hl.window_rule({ match = { class = "^brave-play\\.qobuz\\.com.*" }, no_shadow = true })
hl.window_rule({ match = { class = "^brave-play\\.qobuz\\.com.*" }, opaque    = false })
hl.window_rule({ match = { class = "^brave-play\\.qobuz\\.com.*" }, no_blur   = false })
hl.window_rule({ match = { class = "^brave-play\\.qobuz\\.com.*" }, opacity   = "1 override 0.75 override" })
hl.window_rule({ match = { class = "^brave-play\\.qobuz\\.com.*" }, workspace = "special:music" })

-- ── WAYLYRICS ────────────────────────────────────────────────────
hl.window_rule({ match = { class = "^io\\.github\\.waylyrics\\.Waylyrics$" }, workspace = "special:music silent" })
hl.window_rule({ match = { class = "^io\\.github\\.waylyrics\\.Waylyrics$" }, float     = true })
hl.window_rule({ match = { class = "^io\\.github\\.waylyrics\\.Waylyrics$" }, no_blur   = true })
hl.window_rule({ match = { class = "^io\\.github\\.waylyrics\\.Waylyrics$" }, no_dim    = true })
hl.window_rule({ match = { class = "^io\\.github\\.waylyrics\\.Waylyrics$" }, opaque    = true })

-- ── GESTORES DE ARCHIVOS ─────────────────────────────────────────
hl.window_rule({ match = { class = "^(thunar|Thunar|org.gnome.Nautilus|nemo|pcmanfm)$" }, opacity = "0.92 0.88" })

-- ── IDEs ─────────────────────────────────────────────────────────
hl.window_rule({ match = { class = "^(Code|code-oss|VSCodium)$" },         opacity = "0.95 0.90" })
hl.window_rule({ match = { class = "^(sublime_text|sublime-text)$" },      opacity = "0.94 0.88" })

-- ── COMUNICACIÓN ─────────────────────────────────────────────────
hl.window_rule({ match = { class = "^(discord|Discord|vesktop|WebCord|slack|teams)$" }, opacity = "0.94 0.88" })

-- ── AUDIO ────────────────────────────────────────────────────────
hl.window_rule({ match = { class = "^pavucontrol$" }, float   = true })
hl.window_rule({ match = { class = "^pavucontrol$" }, size    = "800 600" })
hl.window_rule({ match = { class = "^pavucontrol$" }, center  = true })
hl.window_rule({ match = { class = "^pavucontrol$" }, opacity = "0.92 0.88" })

-- ── HACKING ──────────────────────────────────────────────────────
hl.window_rule({ match = { class = "^Burp-StartBurp$" },       float   = true })
hl.window_rule({ match = { class = "^Burp-StartBurp$" },       opacity = "0.96 0.92" })
hl.window_rule({ match = { class = "^sun-awt-X11-XDialog$" },  float   = true })
hl.window_rule({ match = { title = "^Burp Suite" },            float   = true })
hl.window_rule({ match = { title = "^Burp Suite" },            opacity = "0.96 0.92" })
hl.window_rule({ match = { class = "^maltego$" },              float   = true })
hl.window_rule({ match = { class = "^maltego$" },              opacity = "0.98 0.94" })

-- ── WIRESHARK ────────────────────────────────────────────────────
hl.window_rule({ match = { class = "^Wireshark$" },                                               opacity    = "0.96 0.92" })
hl.window_rule({ match = { class = "^Wireshark$", title = "^.*(Dialog|Preferences|Options|Filter|Capture|Statistics|About).*" }, float = true })
hl.window_rule({ match = { class = "^Wireshark$", title = "^.*(Capture|Statistics|About).*" },    center     = true })
hl.window_rule({ match = { class = "^Wireshark$", title = "^Capture.*" },                         size       = "800 600" })
hl.window_rule({ match = { class = "^Wireshark$", title = "^About.*" },                           size       = "600 500" })
hl.window_rule({ match = { class = "^Wireshark$", modal = true },                                 float      = true })
hl.window_rule({ match = { class = "^Wireshark$", modal = true },                                 center     = true })
hl.window_rule({ match = { class = "^Wireshark$", modal = true },                                 no_dim     = true })
hl.window_rule({ match = { class = "^Wireshark$", modal = true },                                 stay_focused = true })
hl.window_rule({ match = { class = "^Wireshark$", floating = true },                              opaque     = true })
hl.window_rule({ match = { class = "^Wireshark$", floating = true },                              no_blur    = true })

-- ── UTILIDADES ───────────────────────────────────────────────────
hl.window_rule({ match = { class = "^localsend$" }, float   = true })
hl.window_rule({ match = { class = "^localsend$" }, size    = "600 500" })
hl.window_rule({ match = { class = "^localsend$" }, center  = true })
hl.window_rule({ match = { class = "^localsend$" }, opacity = "0.92 0.88" })

hl.window_rule({ match = { class = "^ulauncher$" }, float       = true })
hl.window_rule({ match = { class = "^ulauncher$" }, center      = true })
hl.window_rule({ match = { class = "^ulauncher$" }, size        = "50% 40%" })
hl.window_rule({ match = { class = "^ulauncher$" }, rounding    = 32 })
hl.window_rule({ match = { class = "^ulauncher$" }, border_size = 0 })
hl.window_rule({ match = { class = "^ulauncher$" }, opacity     = "0.95 0.88" })
hl.window_rule({ match = { class = "^ulauncher$" }, no_shadow   = true })

-- ── GAMING ───────────────────────────────────────────────────────
hl.window_rule({ match = { class = "^org.prismlauncher.PrismLauncher$" }, float   = true })
hl.window_rule({ match = { class = "^org.prismlauncher.PrismLauncher$" }, size    = "900 600" })
hl.window_rule({ match = { class = "^org.prismlauncher.PrismLauncher$" }, center  = true })
hl.window_rule({ match = { class = "^org.prismlauncher.PrismLauncher$" }, opacity = "0.96 0.92" })

hl.window_rule({ match = { class = "^minecraft-launcher$" }, opaque   = true })
hl.window_rule({ match = { class = "^Minecraft" },           opaque   = true })
hl.window_rule({ match = { class = "^Minecraft" },           immediate = true })
hl.window_rule({ match = { class = "^Minecraft" },           no_blur  = true })
hl.window_rule({ match = { title = "^Minecraft" },           opaque   = true })
hl.window_rule({ match = { title = "^Minecraft" },           immediate = true })
hl.window_rule({ match = { title = "^Minecraft" },           no_blur  = true })

-- ── MEDIA / CREATIVOS ────────────────────────────────────────────
hl.window_rule({ match = { class = "^(mpv|vlc|celluloid)$" },               opaque = true })
hl.window_rule({ match = { class = "^(gimp|Gimp|inkscape|krita|blender)$" },opaque = true })
hl.window_rule({ match = { class = "^(steam|gamescope)$" },                 opaque = true })
hl.window_rule({ match = { class = "^steam$" },                             no_blur = true })

-- ── WORKSPACES ESPECIALES: TV1 / F1 ──────────────────────────────
hl.window_rule({ match = { workspace = "w[tv1]", floating = false }, border_size = 0 })
hl.window_rule({ match = { workspace = "w[tv1]", floating = false }, rounding    = 0 })
hl.window_rule({ match = { workspace = "f[1]",   floating = false }, border_size = 0 })
hl.window_rule({ match = { workspace = "f[1]",   floating = false }, rounding    = 0 })

-- ── NEOVIM SPECIAL ───────────────────────────────────────────────
hl.window_rule({ match = { title = "^nvim-special$" }, workspace = "special:editor silent" })
hl.window_rule({ match = { title = "^nvim-special$" }, float     = true })
hl.window_rule({ match = { title = "^nvim-special$" }, size      = "85% 85%" })
hl.window_rule({ match = { title = "^nvim-special$" }, center    = true })

-- =================================================================
-- LAYER RULES
-- =================================================================
hl.layer_rule({ match = { namespace = "waybar" },                    blur = true, ignore_alpha = 0.3 })
hl.layer_rule({ match = { namespace = "rofi" },                      blur = true, ignore_alpha = 0.3 })
hl.layer_rule({ match = { namespace = "wofi" },                      blur = true, ignore_alpha = 0.5 })
hl.layer_rule({ match = { namespace = "swaync-control-center" },     blur = false, ignore_alpha = 0,
                animation = "slide right" })
hl.layer_rule({ match = { namespace = "swaync-notification-window" }, blur = false, ignore_alpha = 0 })
hl.layer_rule({ match = { namespace = "gtk-layer-shell" },            blur = true, ignore_alpha = 0.3 })

-- =================================================================
-- KEYBINDINGS
-- =================================================================

-- ── APLICACIONES ─────────────────────────────────────────────────
hl.bind(mainMod .. " + Return",         hl.dsp.exec("kitty --single-instance"))
hl.bind(mainMod .. " + SHIFT + Return", hl.dsp.exec("foot"))
hl.bind(mainMod .. " + D",              hl.dsp.exec("ulauncher"))
hl.bind(mainMod .. " + E",              hl.dsp.exec("thunar"))
hl.bind(mainMod .. " + T",              hl.dsp.exec("~/.local/bin/floating_kitty.sh"))
hl.bind(mainMod .. " + A",              hl.dsp.exec("pavucontrol"))
hl.bind(mainMod .. " + SHIFT + F",      hl.dsp.exec("firefox"))
hl.bind(mainMod .. " + SHIFT + B",      hl.dsp.exec("brave-origin-nightly"))
hl.bind(mainMod .. " + SHIFT + C",      hl.dsp.exec("caido"))
hl.bind(mainMod .. " + SHIFT + M",      hl.dsp.exec(
    "brave --ozone-platform=wayland --enable-features=WaylandWindowDecorations --app=\"https://play.qobuz.com/\""
))
hl.bind(mainMod .. " + SHIFT + TAB",    hl.dsp.exec("kitty"))

-- ── SISTEMA / SESIÓN ─────────────────────────────────────────────
hl.bind(mainMod .. " + L",       hl.dsp.exec("~/.config/hypr/scripts/lock.sh"))
hl.bind(mainMod .. " + N",       hl.dsp.exec("swaync-client -t -sw"))
hl.bind(mainMod .. " + Escape",  hl.dsp.exec("hyprctl reload"))
hl.bind(mainMod .. " + M",       hl.dsp.exec("~/.config/waybar/relaunch.sh"))

-- ── SPECIAL WORKSPACES ───────────────────────────────────────────
hl.bind(mainMod .. " + CTRL + M", hl.dsp.togglespecialworkspace("music"))
hl.bind(mainMod .. " + X",        hl.dsp.togglespecialworkspace("editor"))
hl.bind("CTRL + SHIFT + X",       hl.dsp.exec("~/.local/bin/nvim-special-launch.sh"))

-- ── CLIPBOARD ────────────────────────────────────────────────────
hl.bind(mainMod .. " + V",        hl.dsp.exec("cliphist list | rofi -dmenu | cliphist decode | wl-copy"))
hl.bind(mainMod .. " + SHIFT + S",hl.dsp.exec("grim -g \"$(slurp)\" - | wl-copy && notify-send 'Captura' 'Área copiada' -i camera-photo"))

-- ── VENTANAS ─────────────────────────────────────────────────────
hl.bind(mainMod .. " + W", hl.dsp.killactive())
hl.bind(mainMod .. " + S", hl.dsp.togglefloating())
hl.bind(mainMod .. " + F", hl.dsp.fullscreen(0))
hl.bind(mainMod .. " + P", hl.dsp.pseudo())
hl.bind(mainMod .. " + I", hl.dsp.layoutmsg("togglesplit"))

-- ── FOCO ─────────────────────────────────────────────────────────
hl.bind(mainMod .. " + left",  hl.dsp.movefocus("l"))
hl.bind(mainMod .. " + right", hl.dsp.movefocus("r"))
hl.bind(mainMod .. " + up",    hl.dsp.movefocus("u"))
hl.bind(mainMod .. " + down",  hl.dsp.movefocus("d"))

-- ── MOVER VENTANA ────────────────────────────────────────────────
hl.bind(mainMod .. " + SHIFT + left",  hl.dsp.movewindow("l"))
hl.bind(mainMod .. " + SHIFT + right", hl.dsp.movewindow("r"))
hl.bind(mainMod .. " + SHIFT + up",    hl.dsp.movewindow("u"))
hl.bind(mainMod .. " + SHIFT + down",  hl.dsp.movewindow("d"))

-- ── REDIMENSIONAR (repeating) ────────────────────────────────────
hl.bind(mainMod .. " + CTRL + left",  hl.dsp.resizeactive("-20 0"),  { repeat_ = true })
hl.bind(mainMod .. " + CTRL + right", hl.dsp.resizeactive("20 0"),   { repeat_ = true })
hl.bind(mainMod .. " + CTRL + up",    hl.dsp.resizeactive("0 -20"),  { repeat_ = true })
hl.bind(mainMod .. " + CTRL + down",  hl.dsp.resizeactive("0 20"),   { repeat_ = true })

-- ── RATÓN ────────────────────────────────────────────────────────
hl.bind(mainMod .. " + mouse:272", hl.dsp.movewindow(),   { mouse = true })
hl.bind(mainMod .. " + mouse:273", hl.dsp.resizewindow(), { mouse = true })

-- ── ROFI ─────────────────────────────────────────────────────────
hl.bind("ALT + Tab", hl.dsp.exec("rofi -show window -theme ~/.config/rofi/config.rasi"))

-- ── WORKSPACES 1–10 ──────────────────────────────────────────────
for i = 1, 10 do
    local key = (i == 10) and "0" or tostring(i)
    hl.bind(mainMod .. " + " .. key,             hl.dsp.workspace(tostring(i)))
    hl.bind(mainMod .. " + SHIFT + " .. key,     hl.dsp.movetoworkspace(tostring(i)))
    hl.bind(mainMod .. " + CTRL + " .. key,      hl.dsp.movetoworkspacesilent(tostring(i)))
end

-- Navegación relativa
hl.bind(mainMod .. " + ALT + left",   hl.dsp.workspace("e-1"))
hl.bind(mainMod .. " + ALT + right",  hl.dsp.workspace("e+1"))
hl.bind(mainMod .. " + mouse_down",   hl.dsp.workspace("e+1"))
hl.bind(mainMod .. " + mouse_up",     hl.dsp.workspace("e-1"))

-- =================================================================
-- MULTIMEDIA
-- =================================================================
hl.bind("XF86AudioRaiseVolume", hl.dsp.exec("wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+"), { repeat_ = true })
hl.bind("XF86AudioLowerVolume", hl.dsp.exec("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),         { repeat_ = true })
hl.bind("XF86AudioMute",        hl.dsp.exec("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),        { locked = true })
hl.bind("XF86AudioMicMute",     hl.dsp.exec("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"),      { locked = true })
hl.bind("XF86AudioPlay",        hl.dsp.exec("playerctl play-pause"),                              { locked = true })
hl.bind("XF86AudioNext",        hl.dsp.exec("playerctl next"),                                    { locked = true })
hl.bind("XF86AudioPrev",        hl.dsp.exec("playerctl previous"),                                { locked = true })
hl.bind("XF86AudioStop",        hl.dsp.exec("playerctl stop"),                                    { locked = true })
