{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " 󰁔 ",
    "color": {
      "separator": "cyan"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "│  User  ",
      "keyColor": "cyan",
      "format": "{1}@{2}"
    },
    {
      "type": "custom",
      "format": "╭──────────────────────────────────────────╮",
      "outputColor": "blue"
    },
    {
      "type": "os",
      "key": "│ 󰣇 OS      ",
      "keyColor": "blue",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "│  Kernel  ",
      "keyColor": "blue",
      "format": "{2}"
    },
    {
      "type": "uptime",
      "key": "│ 󱫐 Uptime  ",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────┤",
      "outputColor": "blue"
    },
    {
      "type": "wm",
      "key": "│ 󱗃 WM      ",
      "keyColor": "magenta",
      "format": "{2}"
    },
    {
      "type": "terminal",
      "key": "│ >_ Term   ",
      "keyColor": "magenta"
    },
    {
      "type": "display",
      "key": "│ 󰍹 Display ",
      "keyColor": "magenta",
      "format": "{1}x{2} @ {3}Hz"
    },
    {
      "type": "sound",
      "key": "│  Audio   ",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "├──────────────────────────────────────────┤",
      "outputColor": "blue"
    },
    {
      "type": "cpu",
      "key": "│  CPU     ",
      "keyColor": "cyan",
      "format": "{1} @ {7}"
    },
    {
      "type": "gpu",
      "key": "│ 󰊴 GPU     ",
      "keyColor": "cyan",
      "format": "{1} {2}"
    },
    {
      "type": "memory",
      "key": "│  Memory  ",
      "keyColor": "cyan"
    },
    {
      "type": "localip",
      "key": "│ 󰩟 Network ",
      "keyColor": "cyan",
      "showIpv6": false,
      "showMac": false
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────╯",
      "outputColor": "blue"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "round"
    },
    "break"
  ]
}
