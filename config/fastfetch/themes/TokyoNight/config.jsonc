{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " ║ ",
    "color": { "separator": "blue" }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "╔══════════════════════════════════════════╗", "outputColor": "blue" },
    { "type": "title", "key": "║  User  ", "keyColor": "blue" },
    { "type": "os", "key": "║ 󰣇 OS    ", "keyColor": "blue" },
    { "type": "kernel", "key": "║  Kernel", "keyColor": "blue" },
    { "type": "uptime", "key": "║ 󱫐 Uptime", "keyColor": "blue" },
    { "type": "custom", "format": "╠══════════════════════════════════════════╣", "outputColor": "blue" },
    { "type": "wm", "key": "║ 󱗃 WM    ", "keyColor": "magenta" },
    { "type": "terminal", "key": "║ >_ Term ", "keyColor": "magenta" },
    { "type": "cpu", "key": "║  CPU   ", "keyColor": "red" },
    { "type": "memory", "key": "║  Memory", "keyColor": "red" },
    { "type": "custom", "format": "╚══════════════════════════════════════════╝", "outputColor": "blue" },
    "break",
    { "type": "colors", "symbol": "block" }
  ]
}
