{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " // ",
    "color": { "separator": "green" }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "──────────────────────────────────────────", "outputColor": "green" },
    { "type": "title", "key": "Hacker ", "keyColor": "green" },
    { "type": "os", "key": "System ", "keyColor": "green" },
    { "type": "kernel", "key": "Kernel ", "keyColor": "green" },
    { "type": "uptime", "key": "Online ", "keyColor": "green" },
    { "type": "custom", "format": "──────────────────────────────────────────", "outputColor": "green" },
    { "type": "wm", "key": "Env    ", "keyColor": "green" },
    { "type": "cpu", "key": "Core   ", "keyColor": "green" },
    { "type": "memory", "key": "Buffer ", "keyColor": "green" },
    { "type": "custom", "format": "──────────────────────────────────────────", "outputColor": "green" },
    "break"
  ]
}
