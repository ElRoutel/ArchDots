{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " ⚡ ",
    "color": {
      "separator": "yellow"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "║  USER  ",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "╔══════════════════════════════════════════╗",
      "outputColor": "magenta"
    },
    {
      "type": "os",
      "key": "║ 󰣇 OS     ",
      "keyColor": "cyan",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "║  Kernel ",
      "keyColor": "cyan",
      "format": "{2}"
    },
    {
      "type": "uptime",
      "key": "║ 󱫐 Uptime ",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "╠══════════════════════════════════════════╣",
      "outputColor": "magenta"
    },
    {
      "type": "wm",
      "key": "║ 󱗃 WM     ",
      "keyColor": "magenta",
      "format": "{2}"
    },
    {
      "type": "terminal",
      "key": "║  Term   ",
      "keyColor": "magenta"
    },
    {
      "type": "display",
      "key": "║ 󰍹 Display",
      "keyColor": "magenta",
      "format": "{1}x{2} @ {3}Hz"
    },
    {
      "type": "custom",
      "format": "╠══════════════════════════════════════════╣",
      "outputColor": "magenta"
    },
    {
      "type": "cpu",
      "key": "║  CPU    ",
      "keyColor": "cyan",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "║ 󰊴 GPU    ",
      "keyColor": "cyan",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "║ 󰘚 RAM    ",
      "keyColor": "cyan"
    },
    {
      "type": "localip",
      "key": "║ 󰩟 IP     ",
      "keyColor": "cyan",
      "showIpv6": false,
      "showMac": false
    },
    {
      "type": "custom",
      "format": "╚══════════════════════════════════════════╝",
      "outputColor": "magenta"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
