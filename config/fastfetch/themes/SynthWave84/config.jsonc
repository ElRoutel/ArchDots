{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "color": {
      "separator": "magenta"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "│ 󰕇 USER  ",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "╭──────────────────────────────────────────╮",
      "outputColor": "magenta"
    },
    {
      "type": "os",
      "key": "│ 󰣇 OS     ",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "│  KERNEL ",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "│ 󱗃 WM     ",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "│  TERM   ",
      "keyColor": "magenta"
    },
    {
      "type": "display",
      "key": "│ 󰍹 DISP   ",
      "keyColor": "magenta"
    },
    {
      "type": "cpu",
      "key": "│  CPU    ",
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "key": "│ 󰊴 GPU    ",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "│ 󰘚 RAM    ",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────╯",
      "outputColor": "magenta"
    },
    "break"
  ]
}
