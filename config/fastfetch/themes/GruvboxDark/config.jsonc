{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " ─► ",
    "color": { "separator": "yellow" }
  },
  "modules": [
    "break",
    "title",
    "separator",
    { "type": "os", "key": "OS   ", "keyColor": "yellow" },
    { "type": "kernel", "key": "Ker  ", "keyColor": "yellow" },
    { "type": "uptime", "key": "Up   ", "keyColor": "yellow" },
    "break",
    { "type": "wm", "key": "WM   ", "keyColor": "red" },
    { "type": "terminal", "key": "Term ", "keyColor": "red" },
    { "type": "cpu", "key": "CPU  ", "keyColor": "green" },
    { "type": "memory", "key": "Mem  ", "keyColor": "green" },
    "break",
    "colors"
  ]
}
