{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " ██ ",
    "color": {
      "separator": "white"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": "█  USER   ",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "█████████████████████████████████████████████",
      "outputColor": "white"
    },
    {
      "type": "os",
      "key": "█ 󰣇 OS     ",
      "keyColor": "white"
    },
    {
      "type": "kernel",
      "key": "█  KERNEL ",
      "keyColor": "white"
    },
    {
      "type": "uptime",
      "key": "█ 󱫐 UPTIME ",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "█████████████████████████████████████████████",
      "outputColor": "white"
    },
    {
      "type": "wm",
      "key": "█ 󱗃 WM     ",
      "keyColor": "white"
    },
    {
      "type": "terminal",
      "key": "█  TERM   ",
      "keyColor": "white"
    },
    {
      "type": "cpu",
      "key": "█  CPU    ",
      "keyColor": "white"
    },
    {
      "type": "memory",
      "key": "█ 󰘚 RAM    ",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "█████████████████████████████████████████████",
      "outputColor": "white"
    },
    "break"
  ]
}
