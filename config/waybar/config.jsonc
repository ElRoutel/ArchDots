{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "height": 42,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "reload_style_on_change": true,

  "modules-left": [
    "wlr/taskbar"
  ],

  "modules-center": [
    "custom/padd",
    "custom/l_end",
    "clock",
    "custom/padd",
    "mpris",
    "custom/r_end",
    "custom/padd"
  ],

  "modules-right": [
    "custom/padd",
    "custom/l_end",
    "tray",
    "network",
    "pulseaudio#microphone",
    "pulseaudio",
    //"custom/keybindhint",
    "custom/r_end",
    "custom/padd"
  ],

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 20,
    "icon-theme": "Catppuccin-Mocha",
    "spacing": 2,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["Alacritty"],
    "app_ids-mapping": {
      "firefoxdeveloperedition": "firefox-developer-edition"
    }
  },

  "clock": {
    "format": "{:%I:%M %p}",
    "format-alt": "{:%d/%m/%y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "mpris": {
    "format": "{title}  —  {artist}",
    "format-paused": "{title}  —  {artist}",
    "max-length": 50,
    "tooltip-format": "{player} — {artist} — {title}\n{position}/{length}"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8
  },

  "network": {
    "tooltip": true,
    "format-wifi": "<span font='13'>󰖩</span>",
    "format-ethernet": "<span font='13'>󰈀</span>",
    "format-linked": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal: <b>{signaldBm}dBm ({signalStrength}%)</b>\nIP: <b>{ipaddr}/{cidr}</b>",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 2
  },

  "pulseaudio": {
    "format": "<span font='11'>{icon}</span>   <span font='11'>{volume}%</span>",
    "format-muted": "<span font='11'>󰝟  {volume}%</span>",
    "on-click": "pavucontrol -t 3",
    "on-click-middle": "volumecontrol.sh -o m",
    "on-scroll-up": "volumecontrol.sh -o i",
    "on-scroll-down": "volumecontrol.sh -o d",
    "tooltip-format": "{icon} {desc} — {volume}%",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰄝",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"]
    }
  },

  "pulseaudio#microphone": {
    "format": "<span font='11'>{format_source}</span>",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "on-click": "pavucontrol -t 4",
    "on-click-middle": "volumecontrol.sh -i m",
    "on-scroll-up": "volumecontrol.sh -i i",
    "on-scroll-down": "volumecontrol.sh -i d",
    "tooltip-format": "{source_desc} — 󰍬 {source_volume}%",
    "scroll-step": 1
  },

  "custom/keybindhint": {
    "format": "󰌌",
    "tooltip": false,
    "on-click": "keybinds_hint.sh"
  },

  "custom/l_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },

  "custom/r_end": {
    "format": " ",
    "interval": "once",
    "tooltip": false
  },

  "custom/padd": {
    "format": "  ",
    "interval": "once",
    "tooltip": false
  }
}
